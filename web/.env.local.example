# Copy this file to .env.local and fill in your credentials

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-side override of the site URL used in auth redirect/email links
# (e.g. if the server-rendered origin differs from the public one). Falls back to
# NEXT_PUBLIC_SITE_URL when unset — leave unset unless you have a specific reason.
SITE_URL=

# Claude API — resolved automatically by the Anthropic SDK from this exact name.
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pexels API — free tier, 200 req/hour, no attribution needed
# Get your key at https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# Pixabay API — free tier, ~100 req/min, no attribution needed.
# Fallback image provider, used when Pexels' hourly quota is exhausted or a
# search comes back empty. Get your key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key

# Cloudflare Turnstile — bot verification on sign-in/sign-up. Free, no request caps.
# Get keys at https://dash.cloudflare.com > Turnstile. Leave unset to disable (no-op).
# For local dev, use Cloudflare's fixed test keys (always-pass) instead of a real key:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Resend — transactional email (test-send, etc.)
# Get your key at https://resend.com/api-keys — RESEND_FROM_EMAIL must be on a
# domain you've verified in Resend (SPF/DKIM configured) or sends will fail/land in spam.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=you@yourdomain.com

# Paddle — billing. NEXT_PUBLIC_PADDLE_ENVIRONMENT must be exactly "production" to
# use live Paddle; anything else (including unset) runs against sandbox.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=your-paddle-price-id
PADDLE_PRO_PRICE_ID=your-paddle-price-id

# Debug secret for GET /api/paddle/logs — pass as an `x-debug-secret` header.
# Leave unset to disable the endpoint entirely (404). Generate any random string;
# do NOT reuse PADDLE_API_KEY here.
PADDLE_LOGS_DEBUG_SECRET=
